# Server & Networking
HOST=0.0.0.0
PORT=8000
# Public ngrok or reverse proxy URL (e.g. https://xxxx.ngrok-free.app)
PUBLIC_URL=https://your-ngrok-domain.ngrok-free.app

# Primary Telephony Provider: "exotel", "telnyx", "plivo", or "browser"
TELEPHONY_PROVIDER=exotel

# Exotel Telephony (India's Cloud Telephony - https://my.exotel.com/)
# Exotel Account SID / Name
EXOTEL_ACCOUNT_SID=your_exotel_account_sid_here
# Exotel API Key (from Exotel Dashboard -> API Settings)
EXOTEL_API_KEY=your_exotel_api_key_here
# Exotel API Token (from Exotel Dashboard -> API Settings)
EXOTEL_API_TOKEN=your_exotel_api_token_here
# Exotel API Subdomain (api.exotel.com or api.in.exotel.com for Mumbai cluster)
EXOTEL_SUBDOMAIN=api.exotel.com
# Exotel Virtual ExoPhone Number / Caller ID (e.g. 0XXXXXXXXXX or +91XXXXXXXXXX)
EXOTEL_CALLER_ID=+91XXXXXXXXXX
# Optional Exotel Voicebot / Stream Applet Flow ID (from App Bazaar)
EXOTEL_APP_ID=

# Telnyx Telephony Alternative ($10 Free Signup Credit at https://telnyx.com/sign-up)
# Telnyx API Key (from Telnyx Portal -> API Keys)
TELNYX_API_KEY=your_telnyx_api_key_here
# Telnyx Outbound Phone Number (E.164 format)
TELNYX_PHONE_NUMBER=+1XXXXXXXXXX
# Telnyx Call Control Connection ID (from Voice -> Call Control Applications)
TELNYX_CONNECTION_ID=

# Sarvam AI STT & TTS (https://www.sarvam.ai/)
# Sarvam API subscription key
SARVAM_API_KEY=your_sarvam_api_key_here
# Speech-to-Text model
SARVAM_STT_MODEL=saaras:v3
# Language: en-IN (Indian English), hi-IN (Hindi), bn-IN, te-IN, ta-IN, kn-IN
SARVAM_LANGUAGE_CODE=en-IN
# Bulbul TTS voice: priya, ritu, neha, pooja, simran, rahul, aditya
SARVAM_TTS_SPEAKER=priya

# Google Gemini LLM (https://aistudio.google.com/)
# Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here
# Ultra-low latency model for real-time voice
GEMINI_MODEL=gemini-3.5-flash-lite

# Marketing Persona & Campaign
# Name of the AI assistant
AGENT_NAME=Riya
# Company or business name
COMPANY_NAME=ApexGrowth Marketing
# Product or service being pitched
PRODUCT_NAME=AI Growth Acceleration Platform
# Lead magnet or promotional offer
TARGET_OFFER=Complimentary 15-minute Marketing Funnel Audit & Demo
# Target outcome for each call
CALL_OBJECTIVE=Qualify lead interest and book a demo calendar slot

# Audio & Barge-in Tuning
# Audio energy threshold for speech detection
VAD_ENERGY_THRESHOLD=500
# Silence duration in seconds before AI replies
VAD_SILENCE_THRESHOLD_SECONDS=0.7
